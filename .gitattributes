# 统一使用 LF，避免跨平台换行符差异
* text=auto eol=lf

*.ps1    text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.go     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.manifest text eol=lf

# 二进制文件不作换行符处理
*.assets binary
*.syso   binary
*.exe    binary
*.zip    binary
*.png    binary
*.ico    binary
